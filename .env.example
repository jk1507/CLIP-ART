# ClipEngine Configuration

# Server
PORT=8000
HOST=127.0.0.1

# LLM Providers (Choose 'gemini' or 'ollama')
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama Settings (if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Whisper Transcription Settings
# Available models: tiny, base, small, medium, large-v3
WHISPER_MODEL=base
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=auto

# Face Tracking & Framing
FACE_DETECTION_CONFIDENCE=0.5
TRACKING_SMOOTHING_ALPHA=0.15

# Subtitle Customization
SUBTITLE_FONT=Arial
SUBTITLE_FONT_SIZE=28
SUBTITLE_PRIMARY_COLOR=&H00FFFFFF
SUBTITLE_HIGHLIGHT_COLOR=&H0000FFFF
SUBTITLE_OUTLINE_COLOR=&H00000000
SUBTITLE_OUTLINE_WIDTH=3.0

# FFmpeg Hardware Acceleration (auto, cuda, cpu)
HARDWARE_ACCELERATION=auto
